udisk_path: "/mnt/udisk"
config_pattern: "^dyalgo_\\w*.xml"
config_pattern: "^adas\\w*.xml"
config_pattern: "^dms\\w*.xml"
config_pattern: "^bsd\\w*.xml"
config_pattern: "^pfa\\w*.xml"
config_pattern: "^svm\\w*.xml"
config_pattern: "^zcrossing\\w*.xml"
config_pattern: "^trajectory\\w*.xml"
